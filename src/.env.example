PV_DATA_DB_NAME=pv
PV_DATA_DB_USER=pv
PV_DATA_DB_PASSWORD=pv

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── MapTiler (frontend) ──────────────────────────────────
VITE_MAPTILER_KEY=QDyL8SVpZi4TNH5AykBi

# ── Backend ───────────────────────────────────────────────
BOUNDARIES_PATH=/data/boundaries/sigungu_2018_simple.geojson
DATA_ROOT=/data

# 기상청 단기예보 NAS (호스트 CIFS 마운트 경로) → 컨테이너 /nas-weather-data:ro
WEATHER_NAS_HOST_PATH=/mnt/nvme/weather-data-download-center/nas-weather-data

# Martin 타일서버 DB 접속 (평문 비번을 martin.yaml/compose 에 두지 않고 여기서 주입)
MARTIN_DATABASE_URL=postgresql://energy_user:CHANGE_ME@energy-hub-db:5432/energy_hub

# API 문서(/docs·/redoc·/openapi.json) 노출 — 외부 공개 시 0(기본). 로컬 개발만 1
